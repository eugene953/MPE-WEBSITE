def sendStatusEmail(String status) {
    try {
        withCredentials([usernamePassword(
            credentialsId: 'ethereal-smtp',
            usernameVariable: 'ETHEREAL_SMTP_USER',
            passwordVariable: 'ETHEREAL_SMTP_PASSWORD'
        )]) {
            withEnv([
                "EMAIL_STATUS=${status}",
                "EMAIL_BUILD_NAME=${currentBuild.fullDisplayName}",
                "EMAIL_BUILD_URL=${env.BUILD_URL}"
            ]) {
                int result = bat(
                    returnStatus: true,
                    script: 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File .\\frontend\\scripts\\send-jenkins-email.ps1'
                )
                if (result != 0) {
                    echo "Could not send ${status} notification through Ethereal."
                }
            }
        }
    } catch (Exception ignored) {
        echo "Could not send ${status} notification. Check the Jenkins credential 'ethereal-smtp'."
    }
}

pipeline {

    agent any

    stages {

        stage('Verify Node.js') {
            steps {
                bat 'node --version'
                bat 'npm --version'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    bat 'npm ci'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    bat 'npm run build'
                }
            }
        }

        stage('Test Frontend') {
            steps {
                dir('frontend') {
                    bat 'npm test'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t mpe-frontend:latest ./frontend'
            }
        }

    }

     post {
        success {
            script {
                sendStatusEmail('SUCCESS')
            }
        }
        unstable {
            script {
                sendStatusEmail('UNSTABLE')
            }
        }
        failure {
            script {
                sendStatusEmail('FAILURE')
            }
        }
    }
}
