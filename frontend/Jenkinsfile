pipeline {

    agent any

    stages {

        stage('Verify Node.js') {
            steps {
                bat 'node --version'
                bat 'npm --version'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    bat 'npm ci'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    bat 'npm run build'
                }
            }
        }

        stage('Test Frontend') {
            steps {
                dir('frontend') {
                    bat 'npm test'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t mpe-frontend:latest ./frontend'
            }
        }

    }

     post {
        success {
            script {
                try {
                    mail to: 'nfouaeugene545@gmail.com',
                         subject: "Successful Pipeline: ${currentBuild.fullDisplayName}",
                         body: "Pipeline completed successfully. ${env.BUILD_URL}"
                } catch (error) {
                    echo "Could not send success notification: ${error.message}"
                }
            }
        }
        unstable {
            script {
                try {
                    mail to: 'nfouaeugene545@gmail.com',
                         subject: "Unstable Pipeline: ${currentBuild.fullDisplayName}",
                         body: "Pipeline completed with an unstable status. ${env.BUILD_URL}"
                } catch (error) {
                    echo "Could not send unstable notification: ${error.message}"
                }
            }
        }
        failure {
            script {
                try {
                    mail to: 'nfouaeugene545@gmail.com',
                         subject: "Failed Pipeline: ${currentBuild.fullDisplayName}",
                         body: "Something is wrong with ${env.BUILD_URL}"
                } catch (error) {
                    echo "Could not send failure notification: ${error.message}"
                }
            }
        }
    }
}
